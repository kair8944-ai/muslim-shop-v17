rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Products catalog: publicly readable, writable for store management
    match /products/{productId} {
      allow read: if true;
      allow write: if true;
    }

    // Categories: publicly readable, writable for store management
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if true;
    }

    // Store settings: readable by all, writable for store management
    match /settings/{settingId} {
      allow read: if true;
      allow write: if true;
    }

    // Orders: allow customer creation and admin management
    match /orders/{orderId} {
      allow read, write: if true;
    }
  }
}
